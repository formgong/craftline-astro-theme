---
import { SITE } from "../../config";

const t = SITE.trust;
const items = [
  { value: "Licensed & insured", label: `State license ${t.license}` },
  { value: `${t.years} years`, label: `working in ${SITE.address.city}` },
  { value: `${t.rating} out of 5`, label: `from ${t.reviewCount}+ reviews` },
  { value: `${t.responseMinutes} min`, label: "typical emergency arrival" },
];
---

<section aria-label="About the business in numbers" class="border-y border-line bg-surface">
  <div class="container-x">
    <ul class="stagger grid grid-cols-2 lg:grid-cols-4">
      {
        items.map((item, i) => (
          <li class:list={["py-7 sm:py-9", i % 2 === 1 && "border-l border-line pl-5 sm:pl-8", i >= 2 && "border-t border-line lg:border-t-0", i === 2 && "lg:border-l lg:pl-8"]} style={`--i:${i}`}>
            <span class="block text-xl leading-tight font-bold tracking-tight sm:text-2xl">{item.value}</span>
            <span class="mt-1.5 block text-sm text-pretty text-muted">{item.label}</span>
          </li>
        ))
      }
    </ul>
    {t.note && <p class="border-t border-line py-3 text-xs text-muted">{t.note}</p>}
  </div>
</section>
