---
/**
 * Stat counters. The numbers count up once as they scroll into view (CSS only: a registered
 * integer property animated on a view timeline, printed with counter()). Without that support,
 * or with reduced motion, they simply show the final value. Screen readers get the plain text.
 */
import { SITE } from "../../config";

const t = SITE.trust;
const [ratingInt, ratingDec] = String(t.rating).split(".").map(Number);
const stats = [
  { kind: "int", a: t.years, b: 0, suffix: "", label: `years fixing pipes in ${SITE.address.city}`, text: `${t.years}` },
  { kind: "int", a: Math.round(t.jobs / 1000), b: 0, suffix: "k+", label: "jobs finished", text: `${Math.round(t.jobs / 1000)}k+` },
  { kind: "dec", a: ratingInt, b: ratingDec ?? 0, suffix: "", label: `average rating from ${t.reviewCount}+ reviews`, text: `${t.rating}` },
  { kind: "int", a: t.responseMinutes, b: 0, suffix: " min", label: "typical emergency arrival", text: `${t.responseMinutes} min` },
];
---

<section class="section pt-16 sm:pt-20" aria-labelledby="stats-title">
  <div class="container-x">
    <h2 id="stats-title" class="reveal text-xl font-normal text-muted sm:text-2xl">
      Licensed, insured and <span class="hl">local</span>. The numbers so far:
    </h2>
    <span class="rule mt-6" aria-hidden="true"></span>
    <ul class="stagger mt-12 grid grid-cols-2 gap-x-6 gap-y-12 lg:grid-cols-4 lg:gap-x-10">
      {
        stats.map((s, i) => (
          <li class="border-t border-line pt-6" style={`--i:${i}`}>
            <span class="sr-only">
              {s.text} {s.label}
            </span>
            <span class="stat-num" aria-hidden="true">
              <span class:list={["stat-count", s.kind === "dec" && "stat-dec"]} style={`--to-a:${s.a};--to-b:${s.b}`} data-suffix={s.suffix} />
            </span>
            <span class="mt-2 block text-[0.98rem] text-muted" aria-hidden="true">{s.label}</span>
          </li>
        ))
      }
    </ul>
    <p class="mt-10 text-sm text-muted">
      State license {t.license}. {t.note}
    </p>
  </div>
</section>

<style>
  @property --a {
    syntax: "<integer>";
    inherits: false;
    initial-value: 0;
  }
  @property --b {
    syntax: "<integer>";
    inherits: false;
    initial-value: 0;
  }
  .stat-num {
    display: block;
    font-size: clamp(3rem, 2rem + 4vw, 5.25rem);
    font-weight: 300;
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--accent-ink);
    font-variant-numeric: tabular-nums;
  }
  .stat-count {
    --a: var(--to-a);
    --b: var(--to-b);
    counter-reset: a var(--a) b var(--b);
  }
  .stat-count::after {
    content: counter(a) attr(data-suffix);
  }
  .stat-dec::after {
    content: counter(a) "." counter(b);
  }
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .stat-count {
        animation-name: count-up;
        animation-timing-function: cubic-bezier(0.22, 1, 0.36, 1);
        animation-fill-mode: both;
        animation-timeline: view();
        animation-range: entry 20% cover 45%;
      }
    }
  }
  @keyframes count-up {
    from {
      --a: 0;
      --b: 0;
    }
  }
</style>
