---
/**
 * Large rounded media block with one short quote over it. No photos in this theme: the
 * "media" is the same pipe network as the hero, bigger and slower.
 */
import PipeNetwork from "../story/PipeNetwork.astro";

interface Props {
  quote: string;
  who: string;
}
const { quote, who } = Astro.props;
---

<section class="py-10 sm:py-14" aria-label="From a customer">
  <div class="container-x">
    <figure class="quote-panel reveal relative isolate overflow-clip rounded-[1.5rem] border border-line">
      <svg class="quote-net absolute inset-0 -z-10 h-full w-full text-ink" viewBox="0 0 1200 560" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
        <PipeNetwork x={40} y={40} w={1120} h={480} cols={10} rows={5} seed={23} />
      </svg>
      <div class="flex min-h-[26rem] flex-col items-center justify-center px-6 py-16 text-center sm:min-h-[32rem] sm:px-16">
        <blockquote class="max-w-4xl text-[clamp(1.75rem,1.1rem+2.6vw,3.25rem)] leading-[1.15] font-light tracking-tight text-balance">
          <p>“{quote}”</p>
        </blockquote>
        <figcaption class="mt-8 text-[0.98rem] text-muted">{who}</figcaption>
      </div>
    </figure>
  </div>
</section>

<style>
  .quote-panel {
    background: linear-gradient(180deg, #121a33, #0e1226);
  }
  /* lines stay around the edges, the quote sits on a calm centre */
  .quote-net {
    mask-image: radial-gradient(ellipse 62% 58% at 50% 50%, transparent 45%, #000 100%);
  }
</style>
