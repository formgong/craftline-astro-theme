---
import { SITE } from "../../config";
import Icon from "../Icon.astro";
import QuoteForm from "../QuoteForm.astro";
import Highlight from "../Highlight.astro";

interface Props {
  title?: string;
  lead?: string;
  /** Service id to preselect in the form. */
  selected?: string;
}
const {
  title = "Tell us what's wrong and get a *written price*",
  lead = "Add your address and, if you can, a photo. During opening hours we reply within an hour with a price range or a time to visit.",
  selected,
} = Astro.props;
const promises = ["Quotes are free", `${SITE.trust.callOut} call-out, taken off the repair`, "2-year guarantee on labor"];
---

<section id="quote" class="py-16 sm:py-20 lg:py-24" aria-labelledby="quote-title">
  <div class="container-x">
    <div class="grid gap-4 lg:grid-cols-[1fr_1.1fr]">
      <div class="card-accent reveal flex flex-col p-7 sm:p-10 lg:p-12">
        <h2 id="quote-title" class="h-section quote-title"><Highlight text={title} /></h2>
        <p class="mt-5 text-lg leading-relaxed font-medium opacity-80">{lead}</p>
        <ul class="mt-8 space-y-3.5">
          {
            promises.map((p) => (
              <li class="flex items-center gap-3 font-semibold">
                <Icon name="check" size={20} class="shrink-0" />
                {p}
              </li>
            ))
          }
        </ul>
        <div class="mt-auto pt-10">
          <p class="text-sm font-medium opacity-80">Rather talk it through? The office line is open 7 days.</p>
          <a href={`tel:${SITE.phone.tel}`} class="btn btn-dark mt-4">
            <Icon name="phone" />
            {SITE.phone.display}
          </a>
        </div>
      </div>
      <div class="reveal">
        <QuoteForm selected={selected} />
      </div>
    </div>
  </div>
</section>

<style>
  /* On the accent fill the highlighted words switch to dark, underlined. */
  .quote-title :global(.hl) {
    color: inherit;
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.12em;
  }
</style>
