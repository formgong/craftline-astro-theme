---
import { SITE } from "../../config";
import Icon from "../Icon.astro";
import QuoteForm from "../QuoteForm.astro";

interface Props {
  title?: string;
  lead?: string;
  /** Service id to preselect in the form. */
  selected?: string;
}
const {
  title = "Tell us what's wrong and get a written price",
  lead = "Add your address and, if you can, a photo. During opening hours we reply within an hour with a price range or a time to visit.",
  selected,
} = Astro.props;
const promises = ["Quotes are free", `${SITE.trust.callOut} call-out, taken off the repair`, "2-year guarantee on labor"];
---

<section id="quote" class="py-16 sm:py-20 lg:py-24" aria-labelledby="quote-title">
  <div class="container-x">
    <div class="quote-panel relative -mx-4 overflow-clip bg-deep text-white sm:mx-0 sm:rounded-[2rem]">
      <div class="grid gap-12 px-4 py-14 sm:p-10 lg:grid-cols-[1fr_1.1fr] lg:gap-16 lg:p-16">
        <div class="reveal lg:pt-2">
          <h2 id="quote-title" class="h-section">{title}</h2>
          <p class="mt-5 text-lg leading-relaxed text-white/75">{lead}</p>
          <ul class="mt-8 space-y-3.5">
            {
              promises.map((p) => (
                <li class="flex items-center gap-3 font-semibold">
                  <Icon name="check" size={20} class="shrink-0 text-white/70" />
                  {p}
                </li>
              ))
            }
          </ul>
          <div class="mt-10 border-t border-white/15 pt-8">
            <p class="text-sm text-white/70">Rather talk it through? The office line is open 7 days.</p>
            <a href={`tel:${SITE.phone.tel}`} class="btn btn-on-dark mt-4">
              <Icon name="phone" />
              {SITE.phone.display}
            </a>
          </div>
        </div>
        <div class="reveal text-ink">
          <QuoteForm selected={selected} />
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .quote-panel {
    border: 1px solid color-mix(in oklab, white 8%, transparent);
  }
</style>
