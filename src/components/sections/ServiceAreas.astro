---
import { SITE } from "../../config";
import Icon from "../Icon.astro";
import SectionHeading from "../SectionHeading.astro";

// Positions on the decorative map for the first eight areas (the first one is home base).
const SPOTS = [
  [260, 210],
  [255, 92],
  [118, 150],
  [400, 128],
  [415, 268],
  [140, 296],
  [300, 346],
  [92, 392],
] as const;
const pins = SITE.serviceAreas.slice(0, SPOTS.length).map((name, i) => ({ name, x: SPOTS[i][0], y: SPOTS[i][1] }));
const [home, ...others] = pins;
---

<section class="section overflow-x-clip" aria-labelledby="areas-title">
  <div class="container-x grid items-center gap-14 lg:grid-cols-2 lg:gap-16">
    <div>
      <SectionHeading
        id="areas-title"
        title={`${SITE.address.city} and the towns around it`}
        lead="Our vans park overnight in Fernhollow, Cedar Bluff and Quarry Hill, so most addresses on this list are within 30 minutes of one."
      />
      <ul class="stagger mt-8 flex flex-wrap gap-2.5">
        {
          SITE.serviceAreas.map((area, i) => (
            <li class="area-chip" style={`--i:${i % 4}`}>
              <Icon name="map-pin" size={16} />
              {area}
            </li>
          ))
        }
      </ul>
      <p class="reveal mt-8 text-muted">
        Outside these towns, <a href={`tel:${SITE.phone.tel}`} class="font-bold text-accent-ink underline underline-offset-4">call {SITE.phone.display}</a>. If you're too far for us, we'll name a plumber who is closer.
      </p>
    </div>

    <div class="reveal">
      <svg viewBox="0 0 520 440" class="block h-auto w-full" aria-hidden="true" fill="none">
        <defs>
          <pattern id="map-dots" width="22" height="22" patternUnits="userSpaceOnUse">
            <circle cx="2" cy="2" r="1.3" fill="var(--c-line)"></circle>
          </pattern>
          <clipPath id="map-clip"><rect width="520" height="440" rx="28"></rect></clipPath>
        </defs>
        <g clip-path="url(#map-clip)">
          <rect width="520" height="440" fill="var(--c-surface)"></rect>
          <rect width="520" height="440" fill="url(#map-dots)"></rect>
          <path d="M-20 318C90 270 150 368 252 334s170-92 290-48" stroke="var(--accent-soft)" stroke-width="22" stroke-linecap="round"></path>
          <g stroke="var(--c-line)" stroke-width="7" stroke-linecap="round">
            <path d="M20 118c140 26 290-36 510 8"></path>
            <path d="M118 460c60-130 110-250 190-470"></path>
            <path d="M540 400C420 330 360 262 262 212"></path>
          </g>
          <circle cx="260" cy="210" r="152" fill="var(--accent)" fill-opacity=".05" stroke="var(--accent)" stroke-opacity=".5" stroke-width="2" stroke-dasharray="6 9"></circle>
        </g>
        <rect x=".5" y=".5" width="519" height="439" rx="27.5" stroke="var(--c-line)"></rect>

        {
          others.map((pin, i) => (
            <g transform={`translate(${pin.x} ${pin.y})`}>
              <g class="pin-drop" style={`--i:${i}`}>
                <path d="M0 0c-6-7-10-11.4-10-16.5a10 10 0 0 1 20 0C10-11.4 6-7 0 0z" fill="var(--c-ink)"></path>
                <circle cy="-16.5" r="3.6" fill="var(--c-surface)"></circle>
              </g>
              <text y="20" text-anchor="middle" class="map-label">{pin.name}</text>
            </g>
          ))
        }

        {
          home && (
            <g transform={`translate(${home.x} ${home.y})`}>
              <circle class="pulse-ring" r="26" fill="var(--accent)" fill-opacity=".35" />
              <circle class="pulse-ring" style="--d:1.2s" r="26" fill="var(--accent)" fill-opacity=".35" />
              <circle r="11" fill="var(--accent)" stroke="var(--c-surface)" stroke-width="4" />
              <text y="40" text-anchor="middle" class="map-label map-label-home">{home.name}</text>
            </g>
          )
        }
      </svg>
    </div>
  </div>
</section>

<style>
  .area-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.875rem;
    border-radius: 999px;
    border: 1px solid var(--c-line);
    background: var(--c-surface);
    font-size: 0.9375rem;
    font-weight: 600;
  }
  .area-chip :global(.icon) {
    color: var(--accent-ink);
  }
  .map-label {
    fill: var(--c-ink);
    font-size: 14px;
    font-weight: 700;
    paint-order: stroke;
    stroke: var(--c-surface);
    stroke-width: 5px;
    stroke-linejoin: round;
  }
  .map-label-home {
    font-size: 16px;
    font-weight: 800;
  }
</style>
