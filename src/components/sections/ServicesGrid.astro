---
import { getCollection } from "astro:content";
import Icon from "../Icon.astro";
import SectionHeading from "../SectionHeading.astro";
import ServiceCard from "../ServiceCard.astro";

const services = (await getCollection("services")).sort((a, b) => a.data.order - b.data.order);
---

<section class="section" aria-labelledby="services-title">
  <div class="container-x">
    <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
      <SectionHeading
        id="services-title"
        title="What we fix, and what it *usually costs*"
        lead="Starting prices for typical jobs in Fernhollow homes (sample figures). You get the exact price in writing before we start."
      />
      <a href="/services/" class="btn btn-secondary reveal shrink-0 self-start lg:self-auto">
        All services <Icon name="arrow-right" class="icon-shift" />
      </a>
    </div>
    <ul class="stagger mt-14 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        services.map((service, i) => (
          <li style={`--i:${i % 3}`}>
            <ServiceCard service={service} />
          </li>
        ))
      }
    </ul>
  </div>
</section>
