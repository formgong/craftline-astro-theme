---
import { SITE } from "../../config";
import SectionHeading from "../SectionHeading.astro";

const steps = [
  {
    title: "Call or send the form",
    text: "Tell us what's wrong and send a photo if you can. During opening hours we reply within an hour; the emergency line is answered around the clock.",
  },
  {
    title: "Agree a written price",
    text: `We diagnose on site and write down the price: labor, standard parts and cleanup. The ${SITE.trust.callOut} call-out comes off it. Anything extra we find, we price separately and ask first.`,
  },
  {
    title: "We fix it and test it",
    text: "We pressure-test the repair, clean up and email the invoice with before and after photos. Labor is guaranteed for two years.",
  },
];
---

<section class="section border-y border-line bg-surface" aria-labelledby="how-title">
  <div class="container-x">
    <SectionHeading id="how-title" title="How a *repair* works" lead="The same three steps for a dripping tap and a burst pipe." />
    <ol class="stagger mt-14 grid gap-10 lg:grid-cols-3 lg:gap-12">
      {
        steps.map((step, i) => (
          <li class="border-t border-line pt-6" style={`--i:${i}`}>
            <span class="text-sm font-bold text-accent-ink tabular-nums">Step {i + 1}</span>
            <h3 class="mt-2 text-xl font-bold tracking-tight">{step.title}</h3>
            <p class="mt-3 leading-relaxed text-muted">{step.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
