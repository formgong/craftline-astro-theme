---
/**
 * Small one-color line animations for the service cards. Each one explains its service:
 *   pulse  emergency (rings and a heartbeat line)   sonar  leak detection (a sweep finds the leak)
 *   drain  drain cleaning (the blockage clears)     bars   water heaters (temperature rising)
 *   wave   boilers and heating (a heat wave)        drip   fixtures (a drip and its ripples)
 * Drawn in currentColor; static under reduced motion.
 */
export type ArtName = "pulse" | "sonar" | "drain" | "bars" | "wave" | "drip";
interface Props {
  name: ArtName;
}
const { name } = Astro.props;
// A wave long enough to slide one period (60 units) to the right without showing an end.
const wave = (y: number, a: number) => `M-120 ${y}` + Array.from({ length: 6 }, () => `c10-${a} 20-${a} 30 0s20 ${a} 30 0`).join("");
---

<svg class:list={["art", `art-${name}`]} viewBox="0 0 200 72" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {
    name === "pulse" && (
      <>
        <circle cx="30" cy="36" r="4" fill="currentColor" stroke="none" />
        <circle class="ring" cx="30" cy="36" r="8" />
        <circle class="ring ring-2" cx="30" cy="36" r="8" />
        <circle class="ring ring-3" cx="30" cy="36" r="8" />
        <path class="beat" pathLength="1" d="M62 36h38l7-18 10 36 8-30 6 12h63" />
      </>
    )
  }
  {
    name === "sonar" && (
      <>
        <circle cx="36" cy="36" r="30" />
        <circle cx="36" cy="36" r="18" stroke-opacity=".5" />
        <path d="M6 36h60M36 6v60" stroke-opacity=".35" />
        <g class="sweep">
          <path d="M36 36V6" stroke-width="2" />
        </g>
        <circle class="found" cx="52" cy="22" r="3.5" fill="currentColor" stroke="none" />
        <path d="M84 24h40M84 36h70M84 48h52" stroke-opacity=".5" />
      </>
    )
  }
  {
    name === "drain" && (
      <>
        <path d="M8 26h184M8 46h184" />
        <rect class="clog" x="92" y="27.5" width="16" height="17" rx="3" fill="currentColor" stroke="none" />
        <g class="flow">
          <circle cx="20" cy="36" r="3" fill="currentColor" stroke="none" />
          <circle cx="36" cy="36" r="3" fill="currentColor" stroke="none" />
          <circle cx="52" cy="36" r="3" fill="currentColor" stroke="none" />
          <circle cx="68" cy="36" r="3" fill="currentColor" stroke="none" />
        </g>
      </>
    )
  }
  {
    name === "bars" && (
      <>
        <path d="M6 66h188" />
        {[0, 1, 2, 3, 4, 5, 6, 7].map((i) => (
          <rect class="bar" style={`--i:${i}`} x={14 + i * 22} y="10" width="10" height="56" rx="2" fill="currentColor" stroke="none" />
        ))}
      </>
    )
  }
  {
    name === "wave" && (
      <>
        <path class="wave w1" d={wave(42, 16)} />
        <path class="wave w2" d={wave(28, 12)} stroke-opacity=".55" />
        <path d="M6 64h188" />
      </>
    )
  }
  {
    name === "drip" && (
      <>
        <path d="M44 8h28v8" />
        <path class="drop" d="M72 22c3 4 5 6.6 5 9a5 5 0 0 1-10 0c0-2.4 2-5 5-9z" fill="currentColor" stroke="none" />
        <ellipse class="ripple" cx="72" cy="62" rx="10" ry="3" />
        <ellipse class="ripple ripple-2" cx="72" cy="62" rx="10" ry="3" />
        <path d="M110 62h80" stroke-opacity=".5" />
      </>
    )
  }
</svg>

<style>
  .art {
    display: block;
    width: 100%;
    max-width: 15rem;
    height: auto;
  }
  .ring,
  .sweep,
  .bar,
  .ripple,
  .drop {
    transform-box: fill-box;
  }
  .ring,
  .ripple {
    transform-origin: center;
  }
  .sweep {
    transform-box: view-box;
    transform-origin: 36px 36px;
  }
  .bar {
    transform-origin: 50% 100%;
    transform: scaleY(calc(0.35 + var(--i) * 0.09));
  }

  @media (prefers-reduced-motion: no-preference) {
    .ring {
      animation: art-ring 2.4s cubic-bezier(0.22, 1, 0.36, 1) infinite;
    }
    .ring-2 {
      animation-delay: 0.8s;
    }
    .ring-3 {
      animation-delay: 1.6s;
    }
    .beat {
      stroke-dasharray: 1 1;
      animation: art-beat 2.4s linear infinite;
    }
    .sweep {
      animation: art-sweep 3.2s linear infinite;
    }
    .found {
      animation: art-found 3.2s linear infinite;
    }
    .clog {
      animation: art-clog 4s ease-in-out infinite;
    }
    .flow {
      animation: art-flow 4s cubic-bezier(0.4, 0, 0.6, 1) infinite;
    }
    .bar {
      animation: art-bar 2.6s ease-in-out infinite alternate;
      animation-delay: calc(var(--i) * 0.12s);
    }
    .wave {
      animation: art-wave 2.8s linear infinite;
    }
    .w2 {
      animation-duration: 4.2s;
    }
    .drop {
      animation: art-drop 1.8s cubic-bezier(0.55, 0, 1, 0.45) infinite;
    }
    .ripple {
      animation: art-ripple 1.8s cubic-bezier(0.22, 1, 0.36, 1) infinite;
    }
    .ripple-2 {
      animation-delay: 0.25s;
    }
  }

  @keyframes art-ring {
    from {
      opacity: 0.9;
      transform: scale(0.6);
    }
    to {
      opacity: 0;
      transform: scale(3.4);
    }
  }
  @keyframes art-beat {
    from {
      stroke-dashoffset: 1;
    }
    to {
      stroke-dashoffset: -1;
    }
  }
  @keyframes art-sweep {
    to {
      transform: rotate(360deg);
    }
  }
  /* the sweep passes the dot at about 15% of the turn */
  @keyframes art-found {
    0%,
    12% {
      opacity: 0.15;
    }
    16% {
      opacity: 1;
    }
    60%,
    100% {
      opacity: 0.15;
    }
  }
  @keyframes art-clog {
    0%,
    30% {
      opacity: 1;
    }
    40%,
    88% {
      opacity: 0;
    }
    96%,
    100% {
      opacity: 1;
    }
  }
  @keyframes art-flow {
    0%,
    36% {
      transform: translateX(0);
      opacity: 1;
    }
    84% {
      transform: translateX(124px);
      opacity: 1;
    }
    88% {
      transform: translateX(124px);
      opacity: 0;
    }
    92% {
      transform: translateX(0);
      opacity: 0;
    }
    100% {
      transform: translateX(0);
      opacity: 1;
    }
  }
  @keyframes art-bar {
    from {
      transform: scaleY(calc(0.3 + var(--i) * 0.05));
    }
    to {
      transform: scaleY(calc(0.5 + var(--i) * 0.07));
    }
  }
  @keyframes art-wave {
    to {
      transform: translateX(60px);
    }
  }
  @keyframes art-drop {
    0% {
      opacity: 0;
      transform: translateY(0);
    }
    15% {
      opacity: 1;
    }
    70% {
      opacity: 1;
      transform: translateY(30px);
    }
    72%,
    100% {
      opacity: 0;
      transform: translateY(30px);
    }
  }
  @keyframes art-ripple {
    0%,
    68% {
      opacity: 0;
      transform: scale(0.3);
    }
    72% {
      opacity: 1;
    }
    100% {
      opacity: 0;
      transform: scale(2.4);
    }
  }
</style>
