---
import { getCollection } from "astro:content";
import { SITE } from "../config";
import Icon from "./Icon.astro";
import Logo from "./Logo.astro";

const services = (await getCollection("services")).sort((a, b) => a.data.order - b.data.order);
const { address } = SITE;
const year = new Date().getFullYear();
---

<footer class="border-t border-line bg-surface">
  <div class="container-x grid gap-12 py-16 sm:grid-cols-2 sm:py-20 lg:grid-cols-12 lg:gap-8">
    <div class="lg:col-span-4">
      <a href="/" class="inline-flex items-center gap-3 rounded-lg">
        <Logo />
        <span class="text-lg leading-tight font-extrabold tracking-tight">{SITE.name}</span>
      </a>
      <p class="mt-6 max-w-sm text-muted">{SITE.description}</p>
      <ul class="mt-6 flex gap-2">
        {
          SITE.social.map((s) => (
            <li>
              <a href={s.href} class="social-link" rel="noopener" target="_blank">
                <Icon name={s.icon} label={s.label} size={20} />
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <nav aria-labelledby="footer-services" class="lg:col-span-3">
      <h2 id="footer-services" class="footer-heading">Services</h2>
      <ul class="mt-5 space-y-3">
        {
          services.map((s) => (
            <li>
              <a href={`/services/${s.id}/`} class="footer-link">
                {s.data.title}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <nav aria-labelledby="footer-company" class="lg:col-span-2">
      <h2 id="footer-company" class="footer-heading">Company</h2>
      <ul class="mt-5 space-y-3">
        <li><a href="/about/" class="footer-link">About us</a></li>
        <li><a href="/services/" class="footer-link">All services</a></li>
        <li><a href="/contact/" class="footer-link">Contact</a></li>
        <li><a href="/contact/#quote" class="footer-link">Free quote</a></li>
      </ul>
    </nav>

    <div class="lg:col-span-3">
      <h2 class="footer-heading">Get in touch</h2>
      <address class="mt-5 space-y-3 not-italic">
        <a href={`tel:${SITE.phone.tel}`} class="footer-link flex items-center gap-3">
          <Icon name="phone" size={18} class="text-accent-ink" />
          {SITE.phone.display}
        </a>
        <a href={`mailto:${SITE.email}`} class="footer-link flex items-center gap-3">
          <Icon name="mail" size={18} class="text-accent-ink" />
          {SITE.email}
        </a>
        <p class="flex gap-3 text-muted">
          <Icon name="map-pin" size={18} class="mt-0.5 shrink-0 text-accent-ink" />
          <span>{address.street}<br />{address.city}, {address.region} {address.postalCode}</span>
        </p>
      </address>
      <dl class="mt-6 space-y-1.5 text-sm">
        {
          SITE.hours.map((h) => (
            <div class="flex justify-between gap-4">
              <dt class="text-muted">{h.label}</dt>
              <dd class="font-semibold">{h.opens && h.closes ? `${h.opens} – ${h.closes}` : "Closed"}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>

  <div class="border-t border-line">
    <div class="container-x flex flex-col gap-3 py-6 text-sm text-muted sm:flex-row sm:items-center sm:justify-between">
      <p>&copy; {year} {SITE.name}. Demo business: names, figures and reviews are samples.</p>
      <p>
        Built with the Craftline theme for Astro. Forms by <a href="https://formgong.com" class="footer-link underline underline-offset-4">Formgong</a>.
      </p>
    </div>
  </div>
</footer>

<style>
  .footer-heading {
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--c-ink);
  }
  .footer-link {
    color: var(--c-muted);
    border-radius: 0.375rem;
    transition: color 0.2s;
  }
  .footer-link:hover {
    color: var(--c-ink);
  }
  .social-link {
    display: inline-grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 0.75rem;
    border: 1px solid var(--c-line);
    color: var(--c-muted);
    transition:
      color 0.2s,
      border-color 0.2s,
      transform 0.25s var(--ease-out);
  }
  .social-link:hover {
    color: var(--accent-ink);
    border-color: color-mix(in oklab, var(--accent) 45%, var(--c-line));
    transform: translateY(-2px);
  }
  @media (prefers-reduced-motion: reduce) {
    .social-link:hover {
      transform: none;
    }
  }
</style>
