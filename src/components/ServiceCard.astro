---
import type { CollectionEntry } from "astro:content";
import { SITE } from "../config";
import Icon from "./Icon.astro";
import ServiceArt from "./ServiceArt.astro";

interface Props {
  service: CollectionEntry<"services">;
}
const { service } = Astro.props;
const { title, summary, priceFrom, priceNote, duration, featured, art } = service.data;
---

<article class="card-accent card-lift flex h-full flex-col p-7 sm:p-8">
  <h3 class="text-[1.5rem] leading-tight font-semibold tracking-tight">
    <a href={`/services/${service.id}/`} class="stretched rounded-md">{title}</a>
  </h3>
  <p class="mt-3 flex-1 text-[0.98rem] leading-relaxed font-medium opacity-80">{summary}</p>
  <div class="mt-8 mb-6">
    <ServiceArt name={art} />
  </div>
  <div class="flex items-end justify-between gap-4 border-t border-current/20 pt-5">
    <p class="leading-tight">
      {priceFrom && <span class="block text-2xl font-semibold tracking-tight">From {priceFrom}</span>}
      <span class="mt-1 block text-sm font-medium opacity-75">{priceNote ?? duration}</span>
    </p>
    <span class="card-arrow grid size-10 shrink-0 place-items-center rounded-full border border-current/30">
      <Icon name="arrow-right" size={18} />
    </span>
  </div>
  {
    featured && (
      <a href={`tel:${SITE.emergencyPhone.tel}`} class="btn btn-dark relative z-10 mt-6">
        Emergency line {SITE.emergencyPhone.display}
      </a>
    )
  }
</article>

<style>
  .card-arrow :global(.icon) {
    transition: transform 0.3s var(--ease-out);
  }
  article:hover .card-arrow :global(.icon) {
    transform: translateX(3px);
  }
  @media (prefers-reduced-motion: reduce) {
    article:hover .card-arrow :global(.icon) {
      transform: none;
    }
  }
</style>
