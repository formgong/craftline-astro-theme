---
import { SITE } from "../config";
import Icon from "./Icon.astro";
import Logo from "./Logo.astro";

const path = Astro.url.pathname;
const isCurrent = (href: string) => path === href || path.startsWith(href);
---

<header class="site-header">
  <div class="header-backdrop" aria-hidden="true"></div>
  <div class="container-x relative flex h-16 items-center justify-between gap-3 sm:h-[72px]">
    <a href="/" class="header-logo flex min-w-0 items-center gap-3 rounded-lg">
      <Logo class="size-9 sm:size-10" />
      <span class="truncate text-[1.125rem] leading-none font-bold tracking-tight">
        <span class="xl:hidden">{SITE.shortName}</span>
        <span class="hidden xl:inline">{SITE.name}</span>
      </span>
    </a>

    <nav aria-label="Main" class="hidden lg:block">
      <ul class="flex items-center gap-1">
        {
          SITE.nav.map((item) => (
            <li>
              <a href={item.href} class="nav-link" aria-current={isCurrent(item.href) ? "page" : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <a href={`tel:${SITE.phone.tel}`} class="btn btn-secondary hidden min-h-11 px-4 md:inline-flex">
        <Icon name="phone" />
        {SITE.phone.display}
      </a>
      <a href="/contact/#quote" class="btn btn-primary hidden min-h-11 px-4 lg:inline-flex">Get a quote</a>
      <a href={`tel:${SITE.phone.tel}`} class="btn btn-secondary min-h-11 px-4 md:hidden">
        <Icon name="phone" />
        Call<span class="sr-only"> {SITE.phone.display}</span>
      </a>
      <button type="button" popovertarget="mobile-nav" class="menu-btn inline-grid lg:hidden" aria-label="Open menu">
        <Icon name="menu" />
      </button>
    </div>
  </div>

  <div id="mobile-nav" popover class="mobile-nav">
    <div class="container-x flex h-16 items-center justify-between">
      <a href="/" class="flex items-center gap-3 rounded-lg">
        <Logo class="size-9" />
        <span class="text-[1.125rem] leading-none font-bold tracking-tight">{SITE.shortName}</span>
      </a>
      <button type="button" popovertarget="mobile-nav" popovertargetaction="hide" class="menu-btn inline-grid" aria-label="Close menu">
        <Icon name="x" />
      </button>
    </div>
    <nav aria-label="Mobile" class="container-x pt-6">
      <ul class="divide-y divide-line border-y border-line">
        <li><a href="/" class="mobile-link">Home <Icon name="chevron-right" /></a></li>
        {
          SITE.nav.map((item) => (
            <li>
              <a href={item.href} class="mobile-link" aria-current={isCurrent(item.href) ? "page" : undefined}>
                {item.label} <Icon name="chevron-right" />
              </a>
            </li>
          ))
        }
      </ul>
      <div class="mt-8 grid gap-3">
        <a href={`tel:${SITE.phone.tel}`} class="btn btn-primary btn-lg w-full">
          <Icon name="phone" />
          Call {SITE.phone.display}
        </a>
        <a href="/contact/#quote" class="btn btn-secondary btn-lg w-full">Get a free quote</a>
      </div>
      <p class="mt-6 text-sm text-muted">{SITE.hoursNote}</p>
    </nav>
  </div>
</header>

<script>
  // Close the menu when a link inside it is followed (matters for same-page anchors).
  const menu = document.getElementById("mobile-nav");
  menu?.addEventListener("click", (event) => {
    if ((event.target as Element).closest("a")) menu.hidePopover();
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: -0.5rem;
    z-index: 50;
    padding-top: 0.5rem;
    view-transition-name: site-header;
  }
  /* Solid bar with a hairline; it fades in as the page scrolls (see global.css). */
  .header-backdrop {
    position: absolute;
    inset: 0;
    background: var(--c-bg);
    border-bottom: 1px solid var(--c-line);
  }
  .nav-link {
    position: relative;
    display: inline-flex;
    padding: 0.625rem 0.875rem;
    border-radius: 0.625rem;
    font-weight: 600;
    color: var(--c-muted);
    transition: color 0.2s;
  }
  .nav-link::after {
    content: "";
    position: absolute;
    left: 0.875rem;
    right: 0.875rem;
    bottom: 0.3rem;
    height: 2px;
    border-radius: 2px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.3s var(--ease-out);
  }
  .nav-link:hover,
  .nav-link[aria-current="page"] {
    color: var(--c-ink);
  }
  .nav-link:hover::after,
  .nav-link[aria-current="page"]::after {
    transform: scaleX(1);
  }
  /* display comes from utility classes so lg:hidden can win */
  .menu-btn {
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 999px;
    background: var(--accent);
    color: var(--accent-text);
    transition: transform 0.25s var(--ease-out);
  }
  .menu-btn:hover {
    transform: scale(1.06);
  }
  .menu-btn :global(.icon) {
    width: 1.375rem;
    height: 1.375rem;
  }
  .mobile-nav {
    position: fixed;
    inset: 0;
    width: 100%;
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: 0 0 2rem;
    border: 0;
    overflow-y: auto;
    background: var(--c-bg);
    color: var(--c-ink);
  }
  .mobile-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.125rem 0.25rem;
    font-size: 1.75rem;
    font-weight: 300;
    letter-spacing: -0.02em;
  }
  .mobile-link :global(.icon) {
    color: var(--c-muted);
  }
  .mobile-link[aria-current="page"] {
    color: var(--accent-ink);
  }
  @media (prefers-reduced-motion: no-preference) {
    .mobile-nav {
      transition:
        opacity 0.25s var(--ease-out),
        transform 0.3s var(--ease-out),
        overlay 0.3s allow-discrete,
        display 0.3s allow-discrete;
    }
    .mobile-nav:not(:popover-open) {
      opacity: 0;
      transform: translateY(-12px);
    }
    @starting-style {
      .mobile-nav:popover-open {
        opacity: 0;
        transform: translateY(-12px);
      }
    }
  }
</style>
