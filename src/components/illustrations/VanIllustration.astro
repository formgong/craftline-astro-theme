---
/** Service van "driving" in place: wheels turn, the road slides by. Lettering comes from src/config.ts. */
import { SITE } from "../../config";
---

<svg viewBox="0 0 520 320" class="block h-auto w-full" fill="none" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  <defs>
    <clipPath id="van-road"><rect x="0" y="250" width="520" height="40"></rect></clipPath>
    <radialGradient id="van-glow" cx="50%" cy="60%" r="55%">
      <stop offset="0%" stop-color="var(--accent)" stop-opacity=".14"></stop>
      <stop offset="100%" stop-color="var(--accent)" stop-opacity="0"></stop>
    </radialGradient>
  </defs>
  <ellipse cx="260" cy="170" rx="250" ry="150" fill="url(#van-glow)"></ellipse>

  <!-- road -->
  <path d="M10 256h500" stroke="var(--c-ink)" stroke-width="3"></path>
  <g clip-path="url(#van-road)">
    <g class="road-dashes" stroke="var(--c-muted)" stroke-width="4" stroke-opacity=".5">
      <path d="M0 274h36M80 274h36M160 274h36M240 274h36M320 274h36M400 274h36M480 274h36M560 274h36"></path>
    </g>
  </g>

  <!-- speed lines -->
  <g stroke="var(--c-muted)" stroke-width="3" stroke-opacity=".55">
    <path class="speed" style="--d:0s" d="M18 150h34"></path>
    <path class="speed" style="--d:.4s" d="M6 182h46"></path>
    <path class="speed" style="--d:.8s" d="M24 214h28"></path>
  </g>

  <g class="van-body">
    <!-- ladder -->
    <g stroke="var(--c-ink)" stroke-width="3">
      <path d="M96 70h170M96 84h170"></path>
      <path d="M112 70v14M138 70v14M164 70v14M190 70v14M216 70v14M242 70v14"></path>
      <path d="M110 84v8M250 84v8"></path>
    </g>
    <!-- body -->
    <path
      d="M80 92h230c12 0 22 5 30 14l56 64c14 3 24 14 24 28v30c0 8-6 14-14 14H80c-8 0-14-6-14-14V106c0-8 6-14 14-14z"
      fill="var(--c-surface)"
      stroke="var(--c-ink)"
      stroke-width="3"></path>
    <path d="M67 196h352" stroke="var(--accent)" stroke-width="16" stroke-linecap="butt"></path>
    <path d="M320 112l50 58h-50z" fill="var(--c-surface-2)" stroke="var(--c-ink)" stroke-width="3"></path>
    <path d="M304 100v136" stroke="var(--c-ink)" stroke-width="2" stroke-opacity=".4"></path>
    <path d="M318 182h14" stroke="var(--c-ink)" stroke-width="3"></path>
    <rect x="408" y="206" width="10" height="12" rx="3" fill="var(--accent)"></rect>

    <!-- lettering from config -->
    <rect x="92" y="114" width="34" height="34" rx="9" fill="var(--accent)"></rect>
    <path d="M100 131l9-7 9 7" stroke="var(--accent-text)" stroke-width="2.6"></path>
    <path d="M109 129c2.2 2.5 3.6 4.2 3.6 6a3.6 3.6 0 0 1-7.2 0c0-1.8 1.4-3.5 3.6-6z" fill="var(--accent-text)"></path>
    <text x="138" y="136" class="van-name">{SITE.shortName}</text>
    <text x="138" y="160" class="van-phone">{SITE.phone.display}</text>
  </g>

  <!-- wheels -->
  {
    [140, 350].map((cx) => (
      <g transform={`translate(${cx} 242)`}>
        <circle r="28" fill="var(--c-ink)" />
        <circle r="13" fill="var(--c-surface)" />
        <g class="wheel" stroke="var(--c-ink)" stroke-width="3">
          <path d="M0-12V12M-12 0H12" />
        </g>
      </g>
    ))
  }
</svg>

<style>
  .van-name {
    fill: var(--c-ink);
    font-size: 24px;
    font-weight: 800;
    letter-spacing: -0.02em;
  }
  .van-phone {
    fill: var(--c-muted);
    font-size: 15px;
    font-weight: 600;
  }
  .wheel {
    transform-box: fill-box;
    transform-origin: center;
  }
  @media (prefers-reduced-motion: no-preference) {
    .wheel {
      animation: spin 0.9s linear infinite;
    }
    .road-dashes {
      animation: road 0.9s linear infinite;
    }
    .van-body {
      animation: bump 0.9s var(--ease-in-out) infinite;
    }
    .speed {
      animation: speed 1.2s var(--ease-out) infinite;
      animation-delay: var(--d, 0s);
    }
  }
  @keyframes road {
    to {
      transform: translateX(-80px);
    }
  }
  @keyframes bump {
    50% {
      transform: translateY(-1.5px);
    }
  }
  @keyframes speed {
    from {
      opacity: 0;
      transform: translateX(30px);
    }
    40% {
      opacity: 1;
    }
    to {
      opacity: 0;
      transform: translateX(-20px);
    }
  }
</style>
