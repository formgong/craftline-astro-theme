---
/**
 * Decorative map placeholder. Replace it with an embedded map or a static map image of your address.
 * (An iframe map loads third-party scripts and cookies; a static image or a plain link keeps the page fast.)
 */
import { SITE } from "../../config";
const { address } = SITE;
---

<figure class="card overflow-clip">
  <svg viewBox="0 0 560 340" class="block h-auto w-full" fill="none" aria-hidden="true">
    <rect width="560" height="340" fill="var(--c-surface-2)"></rect>
    <rect x="352" y="34" width="150" height="104" rx="18" fill="var(--accent-soft)"></rect>
    <path d="M-10 268c90-36 160 18 250-8s170-80 330-52" stroke="var(--accent-soft)" stroke-width="26" stroke-linecap="round"></path>
    <g stroke="var(--c-surface)" stroke-width="14" stroke-linecap="round">
      <path d="M0 96h560M0 196h560M120 0v340M300 0v340M440 0v340"></path>
    </g>
    <g stroke="var(--c-line)" stroke-width="5" stroke-linecap="round">
      <path d="M0 146h300M210 0v196M370 196v144M120 40h180"></path>
    </g>
    <g transform="translate(300 196)">
      <ellipse class="pulse-ring" rx="34" ry="12" fill="var(--accent)" fill-opacity=".3"></ellipse>
      <g class="map-pin">
        <path d="M0 0c-14-15-24-25-24-38a24 24 0 0 1 48 0C24-25 14-15 0 0z" fill="var(--accent)" stroke="var(--c-surface)" stroke-width="4"></path>
        <circle cy="-38" r="8" fill="var(--c-surface)"></circle>
      </g>
    </g>
  </svg>
  <figcaption class="flex flex-col gap-1 border-t border-line p-5 text-sm sm:flex-row sm:items-center sm:justify-between">
    <span class="font-semibold">{address.street}, {address.city}, {address.region} {address.postalCode}</span>
    <span class="text-muted">Map placeholder</span>
  </figcaption>
</figure>

<style>
  .map-pin {
    transform-box: fill-box;
    transform-origin: 50% 100%;
  }
  @media (prefers-reduced-motion: no-preference) {
    .map-pin {
      animation: bob 2.4s var(--ease-in-out) infinite;
    }
  }
  @keyframes bob {
    50% {
      transform: translateY(-6px);
    }
  }
</style>
