---
import Highlight from "./Highlight.astro";

interface Props {
  /** Wrap key words in *asterisks* to show them in the accent color. */
  title: string;
  lead?: string;
  align?: "left" | "center";
  id?: string;
  class?: string;
}
const { title, lead, align = "left", id, class: className } = Astro.props;
---

<div class:list={["reveal max-w-3xl", align === "center" && "mx-auto text-center", className]}>
  <h2 id={id} class="h-section"><Highlight text={title} /></h2>
  {lead && <p class="lead mt-5">{lead}</p>}
  <span class:list={["rule mt-8", align === "center" && "mx-auto"]} aria-hidden="true"></span>
  <slot />
</div>
