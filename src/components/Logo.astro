---
/** The brand mark. Replace this SVG with your own logo (keep width/height for a stable header). */
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<svg viewBox="0 0 40 40" width="40" height="40" class:list={["shrink-0", className]} aria-hidden="true" focusable="false">
  <rect width="40" height="40" rx="11" fill="var(--accent)"></rect>
  <path d="M9.5 19.5 20 11l10.5 8.5" fill="none" stroke="var(--accent-text)" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"></path>
  <path
    d="M20 17.2c2.6 3 4.3 5.1 4.3 7.2a4.3 4.3 0 0 1-8.6 0c0-2.1 1.7-4.2 4.3-7.2z"
    fill="var(--accent-text)"></path>
</svg>
