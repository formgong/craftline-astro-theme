---
import Icon from "./Icon.astro";

interface Props {
  title: string;
  lead?: string;
  crumbs?: { label: string; href?: string }[];
}
const { title, lead, crumbs = [] } = Astro.props;
---

<section class="border-b border-line">
  <div class="container-x pt-10 pb-14 sm:pt-14 sm:pb-20">
    {
      crumbs.length > 0 && (
        <nav aria-label="Breadcrumb">
          <ol class="flex flex-wrap items-center gap-1.5 text-sm text-muted">
            <li>
              <a href="/" class="rounded hover:text-ink">Home</a>
            </li>
            {crumbs.map((c) => (
              <li class="flex items-center gap-1.5">
                <Icon name="chevron-right" size={14} />
                {c.href ? (
                  <a href={c.href} class="rounded hover:text-ink">{c.label}</a>
                ) : (
                  <span aria-current="page" class="font-semibold text-ink">{c.label}</span>
                )}
              </li>
            ))}
          </ol>
        </nav>
      )
    }
    <div class="mt-8 grid gap-8 lg:grid-cols-[1fr_auto] lg:items-end">
      <div class="max-w-3xl">
        <h1 class="h-display text-[clamp(2.25rem,1.6rem+2.8vw,3.75rem)]">{title}</h1>
        {lead && <p class="lead mt-6">{lead}</p>}
      </div>
      <slot />
    </div>
  </div>
</section>
