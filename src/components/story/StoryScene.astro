---
/**
 * The scroll story scene: one SVG whose objects persist and change across six chapters.
 * Each animated element is driven by one chapter timeline (--ch1 … --ch6, see story.css).
 * Elements that must appear and later disappear are two nested groups, one animation each.
 *
 * Base (non-animated) state = chapter 1: a calm house at night. That is what visitors see
 * when scroll-driven animations are unsupported or reduced motion is on.
 * Decorative only: the captions next to it carry the meaning.
 */
import { SITE } from "../../config";

const stars = [
  [38, 150, 1.6], [150, 36, 1.4], [204, 96, 1.2], [272, 30, 1.8], [338, 74, 1.3], [396, 22, 1.5],
  [430, 112, 1.2], [560, 30, 1.4], [520, 330, 1.3], [468, 352, 1.1], [566, 290, 1.6], [30, 236, 1.2],
] as const;
const starPath = "M0-9 2.6-3.2 9-2.8 4.1 1.3 5.6 7.6 0 4.2-5.6 7.6-4.1 1.3-9-2.8-2.6-3.2z";
---

<svg viewBox="0 0 600 600" class="sc-svg" aria-hidden="true" focusable="false" fill="none" stroke-linecap="round" stroke-linejoin="round">
  <defs>
    <linearGradient id="sc-sky" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#0b1630"></stop>
      <stop offset="1" stop-color="#1c2d52"></stop>
    </linearGradient>
    <linearGradient id="sc-dawn" x1="0" y1="0" x2="0" y2="1">
      <stop offset=".3" stop-color="#ffb46b" stop-opacity="0"></stop>
      <stop offset=".8" stop-color="#f4a36c" stop-opacity=".32"></stop>
    </linearGradient>
    <linearGradient id="sc-cone" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#ffd27a" stop-opacity=".6"></stop>
      <stop offset="1" stop-color="#ffd27a" stop-opacity="0"></stop>
    </linearGradient>
    <radialGradient id="sc-warn">
      <stop offset="0" stop-color="#ff5a3c" stop-opacity=".6"></stop>
      <stop offset="1" stop-color="#ff5a3c" stop-opacity="0"></stop>
    </radialGradient>
    <linearGradient id="sc-screen" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#2b4f86"></stop>
      <stop offset="1" stop-color="#14284a"></stop>
    </linearGradient>
    <linearGradient id="sc-beam" x1="1" y1="0" x2="0" y2="0">
      <stop offset="0" stop-color="#ffe3a3" stop-opacity=".55"></stop>
      <stop offset="1" stop-color="#ffe3a3" stop-opacity="0"></stop>
    </linearGradient>
    <mask id="sc-moon-cut">
      <rect width="600" height="600" fill="#fff"></rect>
      <circle cx="102" cy="76" r="23" fill="#000"></circle>
    </mask>
    <clipPath id="sc-frame"><rect width="600" height="600" rx="32"></rect></clipPath>
  </defs>

  <g clip-path="url(#sc-frame)">
    <!-- sky, dawn, sun -->
    <rect width="600" height="600" fill="url(#sc-sky)"></rect>
    <rect class="sc-dawn hide" width="600" height="600" fill="url(#sc-dawn)"></rect>
    <circle class="sc-sun hide" cx="508" cy="132" r="28" fill="#ffd59a"></circle>

    <!-- night: stars and moon fade at dawn -->
    <g class="sc-night">
      {stars.map(([x, y, r], i) => <circle class="sc-twinkle" style={`--d:${(i % 5) * 0.7}s`} cx={x} cy={y} r={r} fill="#fff" />)}
      <circle cx="86" cy="86" r="26" fill="#f6ecd0" mask="url(#sc-moon-cut)"></circle>
    </g>

    <!-- ground and road -->
    <rect y="470" width="600" height="130" fill="#0a1426"></rect>
    <rect y="500" width="600" height="54" fill="#060e1c"></rect>
    <path d="M0 527h600" stroke="#2b3a58" stroke-width="3" stroke-dasharray="16 16"></path>
    <path d="M0 500h600" stroke="#1d2b48" stroke-width="2"></path>
    <path d="M0 470h600" stroke="var(--sc-line)" stroke-opacity=".35" stroke-width="2"></path>

    <!-- house -->
    <rect x="312" y="156" width="26" height="62" fill="#16264a" stroke="var(--sc-line)" stroke-width="3"></rect>
    <path d="M60 262 230 140l170 122z" fill="#16264a"></path>
    <rect x="80" y="254" width="300" height="216" fill="var(--sc-wall)"></rect>
    <g stroke="var(--sc-line)" stroke-width="3">
      <path d="M58 264 230 138l172 126"></path>
      <path d="M80 470V258M380 258v212"></path>
    </g>
    <g stroke="var(--sc-line)" stroke-width="2" stroke-opacity=".45">
      <path d="M80 360h300M230 258v102M270 360v110"></path>
      <circle cx="230" cy="212" r="14"></circle>
      <path d="M230 198v28M216 212h28"></path>
    </g>

    <!-- upstairs: lit windows that go dark in chapter 1 -->
    <rect class="sc-light-a" x="112" y="278" width="52" height="38" fill="#ffd27a" fill-opacity=".9"></rect>
    <rect class="sc-light-b" x="294" y="278" width="52" height="38" fill="#ffd27a" fill-opacity=".9"></rect>
    <g stroke="var(--sc-line)" stroke-width="2.5">
      <rect x="110" y="276" width="56" height="42" rx="3"></rect>
      <rect x="292" y="276" width="56" height="42" rx="3"></rect>
      <path d="M138 276v42M110 297h56M320 276v42M292 297h56" stroke-opacity=".6"></path>
      <path d="M98 352v-20h68v20M98 340h68"></path>
      <rect x="102" y="324" width="18" height="8" rx="3"></rect>
      <rect x="282" y="330" width="72" height="22" rx="4"></rect>
      <path d="M300 330v22M318 330v22M336 330v22" stroke-opacity=".5"></path>
    </g>

    <!-- kitchen: lamp (on from chapter 2), counter, sink -->
    <g class="sc-lamp-out">
      <path class="sc-lamp hide" d="M138 386h24l32 62h-88z" fill="url(#sc-cone)"></path>
    </g>
    <path d="M150 360v14" stroke="var(--sc-line)" stroke-width="2"></path>
    <path d="M136 386h28l-5-12h-18z" fill="var(--sc-line)"></path>
    <rect x="104" y="414" width="120" height="56" fill="#0b1528" stroke="var(--sc-line)" stroke-width="2.5"></rect>
    <path d="M96 412h140" stroke="var(--sc-line)" stroke-width="4"></path>
    <path d="M124 414v6a8 8 0 0 0 8 8h40a8 8 0 0 0 8-8v-6" stroke="var(--sc-line)" stroke-width="2" stroke-opacity=".6"></path>
    <path d="M192 412v-18a7 7 0 0 0-7-7h-10a5 5 0 0 0-5 5v3" stroke="var(--sc-line)" stroke-width="3"></path>

    <!-- utility room: boiler -->
    <rect x="296" y="392" width="58" height="78" rx="9" fill="var(--sc-wall)" stroke="var(--sc-line)" stroke-width="2.5"></rect>
    <circle cx="325" cy="412" r="9" stroke="var(--sc-line)" stroke-width="2"></circle>
    <path d="m325 412 4-5" stroke="var(--sc-pipe)" stroke-width="2"></path>
    <rect x="313" y="440" width="24" height="16" rx="3" fill="#0b1528" stroke="var(--sc-line)" stroke-width="2"></rect>
    <path class="sc-flame" d="M325 454c2.6 0 4-1.6 4-3.6 0-2-1.8-3-2.4-4.8-.8 1.1-1.4 1.6-2.4 1.9-.2-1 0-2 .4-3-2 1.1-3.6 3-3.6 5.9 0 2 1.4 3.6 4 3.6z" fill="var(--sc-pipe)"></path>

    <!-- warning glow (chapter 2, off in chapter 5) -->
    <g class="sc-warn-out">
      <g class="sc-warn hide">
        <circle class="sc-pulse" cx="203" cy="450" r="64" fill="url(#sc-warn)"></circle>
      </g>
    </g>

    <!-- pipes -->
    <g stroke="var(--sc-pipe)" stroke-width="6">
      <path d="M318 392v-14h-74v72h-30M192 450v-34M262 378v-37h20"></path>
    </g>
    <g class="sc-oldseg">
      <path d="M214 450h-22" stroke="var(--sc-pipe)" stroke-width="6"></path>
      <path class="sc-crack hide" d="m205 442-3 5 4 3-3 5" stroke="#fff" stroke-width="2"></path>
    </g>
    <path class="sc-newseg hide" pathLength="1" d="M214 450h-22" stroke="var(--sc-pipe-new)" stroke-width="6"></path>
    <g fill="var(--sc-wall)" stroke="var(--sc-pipe)" stroke-width="2.5">
      <circle cx="318" cy="378" r="4.5"></circle>
      <circle cx="244" cy="378" r="4.5"></circle>
      <circle cx="262" cy="378" r="4.5"></circle>
      <circle cx="244" cy="450" r="4.5"></circle>
    </g>

    <!-- water flow: before the leak (A) and after the repair (B) -->
    <g class="sc-flow-a">
      <path class="sc-flowing" pathLength="1" d="M318 392v-14h-74v72h-52v-34" stroke="#e7f3ff" stroke-width="2.2" stroke-dasharray=".03 .06" stroke-opacity=".85"></path>
    </g>
    <g class="sc-flow-b hide">
      <path class="sc-flowing" pathLength="1" d="M318 392v-14h-74v72h-52v-34" stroke="#e7f3ff" stroke-width="2.2" stroke-dasharray=".03 .06" stroke-opacity=".85"></path>
    </g>

    <!-- the leak: drips and a growing puddle -->
    <g class="sc-drips-out">
      <g class="sc-drips hide" fill="var(--sc-water)">
        <path class="sc-drip" style="--d:0s" d="M203 455c2 3 3.4 4.6 3.4 6.2a3.4 3.4 0 0 1-6.8 0c0-1.6 1.4-3.2 3.4-6.2z"></path>
        <path class="sc-drip" style="--d:.45s" d="M203 455c2 3 3.4 4.6 3.4 6.2a3.4 3.4 0 0 1-6.8 0c0-1.6 1.4-3.2 3.4-6.2z"></path>
        <path class="sc-drip" style="--d:.9s" d="M203 455c2 3 3.4 4.6 3.4 6.2a3.4 3.4 0 0 1-6.8 0c0-1.6 1.4-3.2 3.4-6.2z"></path>
      </g>
    </g>
    <g class="sc-puddle-out">
      <g class="sc-puddle hide">
        <ellipse cx="170" cy="474" rx="88" ry="6.5" fill="var(--sc-water)" fill-opacity=".55"></ellipse>
        <ellipse cx="150" cy="473" rx="34" ry="2" fill="#e7f3ff" fill-opacity=".6"></ellipse>
      </g>
    </g>

    <!-- repair: wrench -->
    <g class="sc-wrench-out">
      <g class="sc-wrench hide">
        <g transform="translate(232 396) scale(1.5)">
          <path class="sc-wiggle" d="M14.6 4.2a5 5 0 0 0-5.9 6.5l-4.9 4.8a2 2 0 0 0 2.8 2.8l4.8-4.9a5 5 0 0 0 6.5-5.9l-3 3-2.6-.6-.6-2.6z" fill="#0b1528" stroke="#fff" stroke-width="1.75"></path>
        </g>
      </g>
    </g>

    <!-- chapter 3: the quote form on the homeowner's screen -->
    <g class="sc-form-out">
      <g class="sc-form hide">
        <rect x="24" y="24" width="236" height="170" rx="18" fill="#fff"></rect>
        <text x="44" y="56" class="sc-t sc-t-title">Quote request</text>
        <rect x="44" y="70" width="196" height="28" rx="8" fill="#f1efe9"></rect>
        <text x="56" y="89" class="sc-t sc-t-field sc-field1">Leak under kitchen sink</text>
        <rect x="44" y="106" width="196" height="28" rx="8" fill="#f1efe9"></rect>
        <text x="56" y="125" class="sc-t sc-t-field sc-field2">(555) 555-0123</text>
        <g class="sc-press">
          <rect x="44" y="144" width="196" height="34" rx="10" fill="var(--accent)"></rect>
          <text x="142" y="166" text-anchor="middle" class="sc-t sc-t-btn sc-send">Send request</text>
          <g class="sc-sent">
            <text x="136" y="166" text-anchor="middle" class="sc-t sc-t-btn">Sent</text>
            <path d="m159 160 3.5 3.5 7-7" stroke="var(--accent-text)" stroke-width="2.4"></path>
          </g>
        </g>
      </g>
    </g>

    <!-- the request travels to the plumber's phone -->
    <g class="sc-trail-out">
      <path class="sc-trail hide" pathLength="1" d="M236 161C320 70 392 66 458 140" stroke="#ffd27a" stroke-width="2" stroke-opacity=".65"></path>
      <path class="sc-dot hide" pathLength="1" d="M236 161C320 70 392 66 458 140" stroke="#ffd27a" stroke-opacity=".3" stroke-width="22" stroke-dasharray="0 2"></path>
      <path class="sc-dot hide" pathLength="1" d="M236 161C320 70 392 66 458 140" stroke="#fff3cf" stroke-width="10" stroke-dasharray="0 2"></path>
    </g>

    <g class="sc-phone-out">
      <g class="sc-phone hide">
        <rect x="440" y="44" width="136" height="244" rx="24" fill="#1a2742" stroke="#3b4c70" stroke-width="2"></rect>
        <rect x="448" y="52" width="120" height="228" rx="18" fill="#08101e"></rect>
        <g class="sc-screen hide">
          <rect x="448" y="52" width="120" height="228" rx="18" fill="url(#sc-screen)"></rect>
          <text x="508" y="100" text-anchor="middle" class="sc-t sc-t-clock">11:43</text>
        </g>
        <rect x="490" y="58" width="36" height="8" rx="4" fill="#1a2742"></rect>
        <g class="sc-notif hide">
          <rect x="455" y="116" width="106" height="88" rx="12" fill="#fff"></rect>
          <rect x="464" y="126" width="14" height="14" rx="4" fill="var(--accent)"></rect>
          <text x="484" y="137" class="sc-t sc-t-app">Quote form</text>
          <text x="464" y="160" class="sc-t sc-t-ntitle">New request</text>
          <text x="464" y="177" class="sc-t sc-t-nbody">Leak under</text>
          <text x="464" y="192" class="sc-t sc-t-nbody">kitchen sink</text>
        </g>
      </g>
    </g>

    <!-- chapter 4: route and van -->
    <g class="sc-route-out">
      <path class="sc-route hide" pathLength="1" d="M600 527H404" stroke="var(--sc-pipe)" stroke-width="5"></path>
      <g class="sc-pin hide">
        <path d="M392 520c-7-8-12-13-12-19a12 12 0 0 1 24 0c0 6-5 11-12 19z" fill="var(--sc-pipe)" stroke="#060e1c" stroke-width="2"></path>
        <circle cx="392" cy="501" r="4" fill="#060e1c"></circle>
      </g>
    </g>

    <g class="sc-van hide">
      <path class="sc-beam hide" d="M428 512 352 494v38z" fill="url(#sc-beam)"></path>
      <rect x="470" y="458" width="102" height="72" rx="8" fill="#f4f6fa"></rect>
      <path d="M470 474h-24l-20 26v24a6 6 0 0 0 6 6h38z" fill="#f4f6fa"></path>
      <path d="M466 480h-17l-14 18h31z" fill="#20314f"></path>
      <rect x="426" y="507" width="146" height="8" fill="var(--accent)"></rect>
      <rect x="428" y="516" width="7" height="6" rx="2" fill="#ffd27a"></rect>
      <rect x="484" y="468" width="18" height="18" rx="5" fill="var(--accent)"></rect>
      <path d="m488 478 5-4 5 4" stroke="var(--accent-text)" stroke-width="1.6"></path>
      <text x="508" y="482" class="sc-t sc-t-van">{SITE.shortName}</text>
      {
        [452, 544].map((cx) => (
          <g transform={`translate(${cx} 532)`}>
            <circle r="14" fill="#060e1c" stroke="#c6d2e5" stroke-width="3" />
            <g class="sc-wheel">
              <path d="M0-7V7M-7 0H7" stroke="#c6d2e5" stroke-width="2.5" />
            </g>
          </g>
        ))
      }
    </g>

    <g class="sc-chip-out">
      <g class="sc-chip hide">
        <rect x="404" y="402" width="180" height="40" rx="20" fill="#fff"></rect>
        <circle cx="425" cy="422" r="5" fill="#12b76a"></circle>
        <text x="438" y="427" class="sc-t sc-t-chip">Arrives in 25 min</text>
      </g>
    </g>

    <!-- chapter 5: fixed price -->
    <g class="sc-quote-out">
      <g class="sc-quote hide">
        <rect x="24" y="24" width="236" height="150" rx="18" fill="#fff"></rect>
        <text x="44" y="54" class="sc-t sc-t-label">Fixed price</text>
        <text x="44" y="92" class="sc-t sc-t-price">$149</text>
        <text x="44" y="114" class="sc-t sc-t-field">Replace leaking pipe joint</text>
        <rect x="44" y="128" width="196" height="30" rx="9" fill="#0f1a2a"></rect>
        <text x="142" y="148" text-anchor="middle" class="sc-t sc-t-btn sc-approve">Approve price</text>
        <g class="sc-approved">
          <text x="134" y="148" text-anchor="middle" class="sc-t sc-t-btn">Approved</text>
          <path d="m172 142 3.5 3.5 7-7" stroke="#fff" stroke-width="2.4"></path>
        </g>
      </g>
    </g>

    <!-- chapter 6: done (same check geometry as the form's success state) -->
    <g class="sc-done hide">
      <rect x="24" y="24" width="236" height="178" rx="18" fill="#fff"></rect>
      <g transform="translate(40 38) scale(.6)">
        <circle class="sc-check-ring hide" pathLength="1" cx="40" cy="40" r="36" stroke="#12b76a" stroke-width="5"></circle>
        <path class="sc-check-mark hide" pathLength="1" d="M25 41.5 35.5 52 56 30" stroke="#12b76a" stroke-width="6"></path>
      </g>
      <text x="100" y="62" class="sc-t sc-t-title">Leak fixed</text>
      <text x="100" y="80" class="sc-t sc-t-field">12:50 am · floor dry</text>
      <g class="sc-badge hide">
        <rect x="40" y="100" width="172" height="30" rx="15" fill="#fff1e8"></rect>
        <path d="M58 106l7 3v5c0 4-3 7-7 8-4-1-7-4-7-8v-5z" stroke="var(--accent)" stroke-width="1.8"></path>
        <text x="72" y="120" class="sc-t sc-t-badge">2-year guarantee</text>
      </g>
      {
        [0, 1, 2, 3, 4].map((i) => (
          <g transform={`translate(${52 + i * 28} 164)`}>
            <path d={starPath} stroke="#e4e0d7" stroke-width="1.6" />
            <path class={`sc-star sc-star-${i + 1} hide`} d={starPath} fill="#f59e0b" stroke="#f59e0b" stroke-width="1.6" />
          </g>
        ))
      }
    </g>
  </g>
</svg>
