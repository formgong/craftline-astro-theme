---
/**
 * Home page hero + scroll story. The hero illustration is the first frame of the story:
 * the scene stays pinned while six chapter captions scroll past, then the page continues.
 * Motion: CSS scroll-driven animations only (src/styles/story.css). No JavaScript.
 */
import "../../styles/story.css";
import { SITE } from "../../config";
import Icon from "../Icon.astro";
import StoryScene from "./StoryScene.astro";
import StoryVignette from "./StoryVignette.astro";

interface Props {
  title: string;
  /** Part of the title shown in the accent color. */
  highlight: string;
  lead: string;
  points: string[];
}
const { title, highlight, lead, points } = Astro.props;
const [before, after = ""] = title.split(highlight);

const chapters = [
  {
    time: "11:40 pm",
    title: "The house is asleep",
    text: "Behind the kitchen cabinet, the compression joint on a 20-year-old supply pipe has started to weep.",
  },
  {
    time: "11:41 pm",
    title: "A drip under the kitchen sink",
    text: "By the time someone comes down for a glass of water, there's a puddle in front of the cabinet.",
  },
  {
    time: "11:43 pm",
    title: "One form, sent from a phone",
    text: "Name, number and what's wrong. It reaches our on-call plumber's phone within seconds, with the address attached.",
  },
  {
    time: "11:48 pm",
    title: "A van leaves Quarry Hill",
    text: "The plumber texts an arrival time of 25 minutes. Common fittings are already on the van, so there's no stop at a supplier.",
  },
  {
    time: "12:15 am",
    title: "Price first, then the repair",
    text: "We show you the failed joint and agree $149 before starting. Old fitting out, new section of pipe in, water back on.",
  },
  {
    time: "12:50 am",
    title: "Dry floor, two-year guarantee",
    text: "We pressure-test the joint, dry out the cabinet and email the invoice. If that joint leaks within two years, we fix it free.",
  },
] as const;
---

<section class="story" aria-labelledby="hero-title">
  <div class="story-grid container-x">
    <div class="story-hero">
      <p class="text-sm font-semibold text-muted">
        {SITE.address.city} and {SITE.serviceAreas.length - 1} nearby towns · Emergency line open 24/7
      </p>
      <h1 id="hero-title" class="h-display mt-5">
        {before}<span class="text-accent-ink">{highlight}</span>{after}
      </h1>
      <p class="lead mt-6 max-w-xl">{lead}</p>
      <div class="mt-9 flex flex-col gap-3 sm:flex-row">
        <a href="#quote" class="btn btn-primary btn-lg">
          Get a written price
          <Icon name="arrow-right" class="icon-shift" />
        </a>
        <a href={`tel:${SITE.phone.tel}`} class="btn btn-secondary btn-lg">
          <Icon name="phone" />
          Call {SITE.phone.display}
        </a>
      </div>
      <ul class="mt-9 grid gap-2.5 text-[0.9375rem] font-semibold sm:grid-cols-3 sm:gap-4">
        {
          points.map((p) => (
            <li class="flex gap-2">
              <Icon name="check" size={20} class="shrink-0 text-accent-ink" />
              {p}
            </li>
          ))
        }
      </ul>
    </div>

    <div class="story-stage">
      <div class="story-frame">
        <StoryScene />
      </div>
    </div>

    <div class="story-chapters">
      <h2 class="story-heading">How a late-night leak gets fixed</h2>
      <ol>
        {
          chapters.map((c, i) => (
            <li class={`chapter chapter-${i + 1}`}>
              <StoryVignette chapter={(i + 1) as 1 | 2 | 3 | 4 | 5 | 6} />
              <div class="chapter-text reveal">
                <p class="chapter-time">{c.time}</p>
                <h3 class="chapter-title">{c.title}</h3>
                <p class="chapter-body">{c.text}</p>
                {i === chapters.length - 1 && (
                  <a href="#quote" class="btn btn-primary mt-7 whitespace-normal">
                    Send us your problem <Icon name="arrow-right" class="icon-shift" />
                  </a>
                )}
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>
