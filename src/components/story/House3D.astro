---
/**
 * The house as a CSS 3D object (transform-style: preserve-3d, no WebGL, no JavaScript).
 *
 * Scene units: the big scene SVG uses a 1200×600 canvas; one unit is var(--u) pixels
 * (see .sc-layers in story.css). The front face sits exactly where the 2D house used to be
 * (x 80–380, gable peak y 140, floor y 470), on the screen plane (z = 0); the box extends
 * 200 units behind it. Wrappers, outside in:
 *   .h3d          anchor at the house centre (x 230, y 362, z −100)
 *   .h3d-c2 … c6  one scroll-driven rotation per chapter (sway, then the final 3/4 view)
 *   .h3d-idle     the hero turntable; its influence fades to zero as chapter 1 arrives
 * The front face is the cutaway: everything the story animates inside the house lives here,
 * with the same sc-* classes as before.
 */
---

<div class="h3d" aria-hidden="true">
  <div class="h3d-r h3d-c2">
    <div class="h3d-r h3d-c3">
      <div class="h3d-r h3d-c4">
        <div class="h3d-r h3d-c5">
          <div class="h3d-r h3d-c6">
            <div class="h3d-r h3d-idle">
              <!-- front: the cutaway (viewBox = scene coordinates, so nothing moved) -->
              <div class="h3d-face h3d-front">
                <svg viewBox="80 140 300 330" fill="none" stroke-linecap="round" stroke-linejoin="round" overflow="visible">
                  <defs>
                    <linearGradient id="h3d-cone" x1="0" y1="0" x2="0" y2="1">
                      <stop offset="0" stop-color="#ffd27a" stop-opacity=".6"></stop>
                      <stop offset="1" stop-color="#ffd27a" stop-opacity="0"></stop>
                    </linearGradient>
                    <radialGradient id="h3d-warn">
                      <stop offset="0" stop-color="#ff5a3c" stop-opacity=".6"></stop>
                      <stop offset="1" stop-color="#ff5a3c" stop-opacity="0"></stop>
                    </radialGradient>
                  </defs>
                  <path d="M80 254 230 140l150 114z" fill="#16264a"></path>
                  <rect x="80" y="254" width="300" height="216" fill="var(--sc-wall)"></rect>
                  <path d="M80 470V254L230 140l150 114v216" stroke="var(--sc-line)" stroke-width="3"></path>
                  <g stroke="var(--sc-line)" stroke-width="2" stroke-opacity=".45">
                    <path d="M80 254h300M80 360h300M230 254v106M270 360v110"></path>
                    <circle cx="230" cy="212" r="14"></circle>
                    <path d="M230 198v28M216 212h28"></path>
                  </g>

                  <!-- upstairs: lit windows that go dark in chapter 1 -->
                  <rect class="sc-light-a" x="112" y="278" width="52" height="38" fill="#ffd27a" fill-opacity=".9"></rect>
                  <rect class="sc-light-b" x="294" y="278" width="52" height="38" fill="#ffd27a" fill-opacity=".9"></rect>
                  <g stroke="var(--sc-line)" stroke-width="2.5">
                    <rect x="110" y="276" width="56" height="42" rx="3"></rect>
                    <rect x="292" y="276" width="56" height="42" rx="3"></rect>
                    <path d="M138 276v42M110 297h56M320 276v42M292 297h56" stroke-opacity=".6"></path>
                    <path d="M98 352v-20h68v20M98 340h68"></path>
                    <rect x="102" y="324" width="18" height="8" rx="3"></rect>
                    <rect x="282" y="330" width="72" height="22" rx="4"></rect>
                    <path d="M300 330v22M318 330v22M336 330v22" stroke-opacity=".5"></path>
                  </g>

                  <!-- kitchen: lamp (on from chapter 2), counter, sink -->
                  <g class="sc-lamp-out">
                    <path class="sc-lamp hide" d="M138 386h24l32 62h-88z" fill="url(#h3d-cone)"></path>
                  </g>
                  <path d="M150 360v14" stroke="var(--sc-line)" stroke-width="2"></path>
                  <path d="M136 386h28l-5-12h-18z" fill="var(--sc-line)"></path>
                  <rect x="104" y="414" width="120" height="56" fill="#0b1528" stroke="var(--sc-line)" stroke-width="2.5"></rect>
                  <path d="M96 412h140" stroke="var(--sc-line)" stroke-width="4"></path>
                  <path d="M124 414v6a8 8 0 0 0 8 8h40a8 8 0 0 0 8-8v-6" stroke="var(--sc-line)" stroke-width="2" stroke-opacity=".6"></path>
                  <path d="M192 412v-18a7 7 0 0 0-7-7h-10a5 5 0 0 0-5 5v3" stroke="var(--sc-line)" stroke-width="3"></path>

                  <!-- utility room: boiler -->
                  <rect x="296" y="392" width="58" height="78" rx="9" fill="var(--sc-wall)" stroke="var(--sc-line)" stroke-width="2.5"></rect>
                  <circle cx="325" cy="412" r="9" stroke="var(--sc-line)" stroke-width="2"></circle>
                  <path d="m325 412 4-5" stroke="var(--sc-pipe)" stroke-width="2"></path>
                  <rect x="313" y="440" width="24" height="16" rx="3" fill="#0b1528" stroke="var(--sc-line)" stroke-width="2"></rect>
                  <path class="sc-flame" d="M325 454c2.6 0 4-1.6 4-3.6 0-2-1.8-3-2.4-4.8-.8 1.1-1.4 1.6-2.4 1.9-.2-1 0-2 .4-3-2 1.1-3.6 3-3.6 5.9 0 2 1.4 3.6 4 3.6z" fill="var(--sc-pipe)"></path>

                  <!-- warning glow (chapter 2, off in chapter 5) -->
                  <g class="sc-warn-out">
                    <g class="sc-warn hide">
                      <circle class="sc-pulse" cx="203" cy="450" r="64" fill="url(#h3d-warn)"></circle>
                    </g>
                  </g>

                  <!-- pipes -->
                  <path d="M318 392v-14h-74v72h-30M192 450v-34M262 378v-37h20" stroke="var(--sc-pipe)" stroke-width="6"></path>
                  <g class="sc-oldseg">
                    <path d="M214 450h-22" stroke="var(--sc-pipe)" stroke-width="6"></path>
                    <path class="sc-crack hide" d="m205 442-3 5 4 3-3 5" stroke="#fff" stroke-width="2"></path>
                  </g>
                  <path class="sc-newseg hide" pathLength="1" d="M214 450h-22" stroke="var(--sc-pipe-new)" stroke-width="6"></path>
                  <g fill="var(--sc-wall)" stroke="var(--sc-pipe)" stroke-width="2.5">
                    <circle cx="318" cy="378" r="4.5"></circle>
                    <circle cx="244" cy="378" r="4.5"></circle>
                    <circle cx="262" cy="378" r="4.5"></circle>
                    <circle cx="244" cy="450" r="4.5"></circle>
                  </g>

                  <!-- water flow: before the leak (A) and after the repair (B) -->
                  <g class="sc-flow-a">
                    <path class="sc-flowing" pathLength="1" d="M318 392v-14h-74v72h-52v-34" stroke="#e7f3ff" stroke-width="2.2" stroke-dasharray=".03 .06" stroke-opacity=".85"></path>
                  </g>
                  <g class="sc-flow-b hide">
                    <path class="sc-flowing" pathLength="1" d="M318 392v-14h-74v72h-52v-34" stroke="#e7f3ff" stroke-width="2.2" stroke-dasharray=".03 .06" stroke-opacity=".85"></path>
                  </g>

                  <!-- the leak: drips and a growing puddle -->
                  <g class="sc-drips-out">
                    <g class="sc-drips hide" fill="var(--sc-water)">
                      <path class="sc-drip" style="--d:0s" d="M203 455c2 3 3.4 4.6 3.4 6.2a3.4 3.4 0 0 1-6.8 0c0-1.6 1.4-3.2 3.4-6.2z"></path>
                      <path class="sc-drip" style="--d:.45s" d="M203 455c2 3 3.4 4.6 3.4 6.2a3.4 3.4 0 0 1-6.8 0c0-1.6 1.4-3.2 3.4-6.2z"></path>
                      <path class="sc-drip" style="--d:.9s" d="M203 455c2 3 3.4 4.6 3.4 6.2a3.4 3.4 0 0 1-6.8 0c0-1.6 1.4-3.2 3.4-6.2z"></path>
                    </g>
                  </g>
                  <g class="sc-puddle-out">
                    <g class="sc-puddle hide">
                      <ellipse cx="170" cy="474" rx="88" ry="6.5" fill="var(--sc-water)" fill-opacity=".55"></ellipse>
                      <ellipse cx="150" cy="473" rx="34" ry="2" fill="#e7f3ff" fill-opacity=".6"></ellipse>
                    </g>
                  </g>

                  <!-- repair: wrench -->
                  <g class="sc-wrench-out">
                    <g class="sc-wrench hide">
                      <g transform="translate(232 396) scale(1.5)">
                        <path class="sc-wiggle" d="M14.6 4.2a5 5 0 0 0-5.9 6.5l-4.9 4.8a2 2 0 0 0 2.8 2.8l4.8-4.9a5 5 0 0 0 6.5-5.9l-3 3-2.6-.6-.6-2.6z" fill="#0b1528" stroke="#fff" stroke-width="1.75"></path>
                      </g>
                    </g>
                  </g>
                </svg>
              </div>

              <!-- back: gable wall with a door and windows -->
              <div class="h3d-face h3d-back">
                <svg viewBox="0 0 300 330" fill="none" stroke-linecap="round" stroke-linejoin="round" overflow="visible">
                  <path d="M0 330V114L150 0l150 114v216z" fill="#0f1a2f" stroke="var(--sc-line)" stroke-width="3"></path>
                  <path d="M0 114h300" stroke="var(--sc-line)" stroke-width="2" stroke-opacity=".35"></path>
                  <circle cx="150" cy="72" r="14" stroke="var(--sc-line)" stroke-width="2" stroke-opacity=".5"></circle>
                  <rect class="sc-light-a" x="42" y="138" width="52" height="38" fill="#ffd27a" fill-opacity=".85"></rect>
                  <rect x="40" y="136" width="56" height="42" rx="3" stroke="var(--sc-line)" stroke-width="2.5"></rect>
                  <rect x="196" y="136" width="56" height="42" rx="3" fill="#0b1528" stroke="var(--sc-line)" stroke-width="2.5"></rect>
                  <rect x="200" y="236" width="46" height="94" rx="2" fill="#0b1528" stroke="var(--sc-line)" stroke-width="2.5"></rect>
                  <rect x="44" y="246" width="56" height="42" rx="3" fill="#0b1528" stroke="var(--sc-line)" stroke-width="2.5"></rect>
                </svg>
              </div>

              <!-- left side: front door and a window -->
              <div class="h3d-face h3d-left">
                <svg viewBox="0 0 200 216" fill="none" stroke-linecap="round" stroke-linejoin="round" overflow="visible">
                  <rect width="200" height="216" fill="#101b31" stroke="var(--sc-line)" stroke-width="3"></rect>
                  <path d="M0 106h200" stroke="var(--sc-line)" stroke-width="2" stroke-opacity=".3"></path>
                  <rect class="sc-light-a" x="112" y="26" width="52" height="38" fill="#ffd27a" fill-opacity=".85"></rect>
                  <rect x="110" y="24" width="56" height="42" rx="3" stroke="var(--sc-line)" stroke-width="2.5"></rect>
                  <rect x="34" y="122" width="48" height="94" rx="2" fill="#0b1528" stroke="var(--sc-line)" stroke-width="2.5"></rect>
                  <circle cx="72" cy="172" r="3" fill="var(--sc-pipe)"></circle>
                  <rect x="112" y="134" width="56" height="40" rx="3" fill="#0b1528" stroke="var(--sc-line)" stroke-width="2.5"></rect>
                </svg>
              </div>

              <!-- right side: two windows -->
              <div class="h3d-face h3d-right">
                <svg viewBox="0 0 200 216" fill="none" stroke-linecap="round" stroke-linejoin="round" overflow="visible">
                  <rect width="200" height="216" fill="#182a4c" stroke="var(--sc-line)" stroke-width="3"></rect>
                  <path d="M0 106h200" stroke="var(--sc-line)" stroke-width="2" stroke-opacity=".3"></path>
                  <rect class="sc-light-b" x="38" y="26" width="52" height="38" fill="#ffd27a" fill-opacity=".85"></rect>
                  <rect x="36" y="24" width="56" height="42" rx="3" stroke="var(--sc-line)" stroke-width="2.5"></rect>
                  <rect x="112" y="134" width="56" height="40" rx="3" fill="#0b1528" stroke="var(--sc-line)" stroke-width="2.5"></rect>
                  <path d="M140 134v40M112 154h56" stroke="var(--sc-line)" stroke-width="2" stroke-opacity=".5"></path>
                </svg>
              </div>

              <div class="h3d-face h3d-floor"></div>
              <div class="h3d-face h3d-roof h3d-roof-l"></div>
              <div class="h3d-face h3d-roof h3d-roof-r"></div>

              <div class="h3d-r h3d-chimney">
                <div class="h3d-face h3d-ch h3d-ch-front"></div>
                <div class="h3d-face h3d-ch h3d-ch-back"></div>
                <div class="h3d-face h3d-ch h3d-ch-left"></div>
                <div class="h3d-face h3d-ch h3d-ch-right"></div>
                <div class="h3d-face h3d-ch-top"></div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
