---
/**
 * Small static picture for one chapter. Shown next to the caption when the scroll scene is off
 * (no scroll-driven animation support, or reduced motion), so the story still reads.
 */
interface Props {
  chapter: 1 | 2 | 3 | 4 | 5 | 6;
}
const { chapter } = Astro.props;
---

<svg viewBox="0 0 120 90" class="vignette" aria-hidden="true" focusable="false" fill="none" stroke-linecap="round" stroke-linejoin="round">
  <rect width="120" height="90" rx="14" fill="#13213c"></rect>
  {
    chapter === 1 && (
      <>
        <circle cx="96" cy="20" r="8" fill="#f6ecd0" />
        <circle cx="100" cy="17" r="7" fill="#13213c" />
        <path d="M28 52 60 30l32 22" stroke="#c6d2e5" stroke-width="2.5" />
        <path d="M34 50v28h52V50" stroke="#c6d2e5" stroke-width="2.5" />
        <rect x="44" y="56" width="12" height="10" rx="1.5" stroke="#c6d2e5" stroke-width="1.5" />
        <rect x="64" y="56" width="12" height="10" rx="1.5" stroke="#c6d2e5" stroke-width="1.5" />
      </>
    )
  }
  {
    chapter === 2 && (
      <>
        <path d="M20 40h70" stroke="#c6d2e5" stroke-width="3" />
        <rect x="26" y="41" width="58" height="30" fill="#0b1528" stroke="#c6d2e5" stroke-width="2" />
        <path d="M84 56H50v-14" stroke="var(--sc-pipe)" stroke-width="4" />
        <path d="m62 51-2 3 3 2-2 3" stroke="#fff" stroke-width="1.5" />
        <path d="M61 61c1.4 2 2.3 3.1 2.3 4.2a2.3 2.3 0 0 1-4.6 0c0-1.1.9-2.2 2.3-4.2z" fill="#7cc4ff" />
        <ellipse cx="54" cy="76" rx="36" ry="4" fill="#7cc4ff" fill-opacity=".55" />
      </>
    )
  }
  {
    chapter === 3 && (
      <>
        <rect x="12" y="22" width="44" height="40" rx="6" fill="#fff" />
        <rect x="18" y="28" width="32" height="6" rx="2" fill="#e4e0d7" />
        <rect x="18" y="38" width="32" height="6" rx="2" fill="#e4e0d7" />
        <rect x="18" y="49" width="32" height="8" rx="2.5" fill="var(--accent)" />
        <path d="M54 50c12-24 22-28 30-22" stroke="#ffd27a" stroke-width="1.5" stroke-dasharray="3 3" />
        <rect x="80" y="14" width="28" height="62" rx="6" fill="#2b4f86" stroke="#3b4c70" stroke-width="1.5" />
        <rect x="83" y="28" width="22" height="16" rx="3" fill="#fff" />
        <circle cx="84" cy="27" r="3.5" fill="#ffd27a" />
      </>
    )
  }
  {
    chapter === 4 && (
      <>
        <rect y="58" width="120" height="20" fill="#060e1c" />
        <path d="M118 68H22" stroke="var(--sc-pipe)" stroke-width="3" />
        <rect x="58" y="38" width="44" height="26" rx="4" fill="#f4f6fa" />
        <path d="M58 44H48l-8 10v8a2 2 0 0 0 2 2h16z" fill="#f4f6fa" />
        <rect x="40" y="56" width="62" height="3" fill="var(--accent)" />
        <circle cx="50" cy="66" r="5" fill="#060e1c" stroke="#c6d2e5" stroke-width="2" />
        <circle cx="90" cy="66" r="5" fill="#060e1c" stroke="#c6d2e5" stroke-width="2" />
        <path d="M18 66c-3-3.5-5-5.6-5-8a5 5 0 0 1 10 0c0 2.4-2 4.5-5 8z" fill="var(--sc-pipe)" />
      </>
    )
  }
  {
    chapter === 5 && (
      <>
        <rect x="12" y="16" width="56" height="48" rx="7" fill="#fff" />
        <text x="20" y="34" class="vg-t vg-small">Fixed price</text>
        <text x="20" y="54" class="vg-t vg-price">$149</text>
        <path d="M74 66h20v-24" stroke="var(--sc-pipe)" stroke-width="4" />
        <path d="M94 66h18" stroke="var(--sc-pipe-new)" stroke-width="4" />
        <path d="M92.6 18.2a4 4 0 0 0-4.7 5.2l-3.9 3.8a1.6 1.6 0 0 0 2.2 2.2l3.8-3.9a4 4 0 0 0 5.2-4.7l-2.4 2.4-2.1-.5-.5-2.1z" fill="#0b1528" stroke="#fff" stroke-width="1.4" />
      </>
    )
  }
  {
    chapter === 6 && (
      <>
        <circle cx="60" cy="36" r="17" stroke="#12b76a" stroke-width="3" />
        <path d="m52 36.5 5 5 10-10.5" stroke="#12b76a" stroke-width="3.5" />
        {[0, 1, 2, 3, 4].map((i) => (
          <path
            transform={`translate(${36 + i * 12} 70) scale(.55)`}
            d="M0-9 2.6-3.2 9-2.8 4.1 1.3 5.6 7.6 0 4.2-5.6 7.6-4.1 1.3-9-2.8-2.6-3.2z"
            fill="#f59e0b"
          />
        ))}
      </>
    )
  }
</svg>
