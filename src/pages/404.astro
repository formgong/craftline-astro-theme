---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
---

<BaseLayout title="Page not found" description="This page doesn't exist." noindex>
  <section class="relative overflow-x-clip">
    <div class="container-x grid items-center gap-12 py-20 sm:py-28 lg:grid-cols-2">
      <div>
        <p class="text-sm font-bold text-accent-ink">Error 404</p>
        <h1 class="h-display mt-4">This pipe leads nowhere</h1>
        <p class="lead mt-6 max-w-lg">The page has moved or never existed. Try one of these instead.</p>
        <div class="mt-9 flex flex-col gap-3 sm:flex-row">
          <a href="/" class="btn btn-primary btn-lg">Home <Icon name="arrow-right" class="icon-shift" /></a>
          <a href="/services/" class="btn btn-secondary btn-lg">Services</a>
          <a href="/contact/" class="btn btn-secondary btn-lg">Contact</a>
        </div>
      </div>
      <svg viewBox="0 0 420 300" class="mx-auto block h-auto w-full max-w-md" fill="none" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M20 70h150a30 30 0 0 1 30 30v40" stroke="var(--accent)" stroke-width="22"></path>
        <rect x="186" y="132" width="28" height="18" rx="4" fill="var(--c-ink)"></rect>
        <path d="M400 230H290a30 30 0 0 1-30-30v-24" stroke="var(--accent)" stroke-width="22" stroke-opacity=".4"></path>
        <rect x="246" y="158" width="28" height="18" rx="4" fill="var(--c-ink)" fill-opacity=".4"></rect>
        <g fill="var(--accent)">
          <path class="fall" style="--d:0s" d="M200 160c3 4 5 6.5 5 9a5 5 0 0 1-10 0c0-2.5 2-5 5-9z"></path>
          <path class="fall" style="--d:.6s" d="M200 160c3 4 5 6.5 5 9a5 5 0 0 1-10 0c0-2.5 2-5 5-9z"></path>
          <path class="fall" style="--d:1.2s" d="M200 160c3 4 5 6.5 5 9a5 5 0 0 1-10 0c0-2.5 2-5 5-9z"></path>
        </g>
        <ellipse cx="200" cy="262" rx="56" ry="9" fill="var(--accent-soft)"></ellipse>
      </svg>
    </div>
  </section>
</BaseLayout>

<style>
  @media (prefers-reduced-motion: no-preference) {
    .fall {
      animation: fall 1.8s cubic-bezier(0.55, 0, 1, 0.45) infinite;
      animation-delay: var(--d, 0s);
    }
  }
  @keyframes fall {
    0% {
      opacity: 0;
      transform: translateY(0);
    }
    12% {
      opacity: 1;
    }
    85% {
      opacity: 1;
    }
    100% {
      opacity: 0;
      transform: translateY(92px);
    }
  }
</style>
