---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import Icon from "../components/Icon.astro";
import QuoteForm from "../components/QuoteForm.astro";
import MapPlaceholder from "../components/illustrations/MapPlaceholder.astro";
import { SITE } from "../config";

const { address } = SITE;
---

<BaseLayout
  title="Contact and quotes"
  description={`Call ${SITE.phone.display} or send a quote request to ${SITE.name}. We reply within an hour during opening hours; the emergency line is open 24/7.`}
>
  <PageHeader
    title="Get a written price"
    lead="Describe the problem and we'll reply within an hour during opening hours. For a burst pipe or no heat, call the emergency line instead."
    crumbs={[{ label: "Contact" }]}
  />

  <section class="section" aria-label="Contact details and quote form">
    <div class="container-x grid gap-12 lg:grid-cols-12 lg:gap-10">
      <div id="quote" class="reveal lg:col-span-7">
        <h2 class="text-2xl font-bold tracking-tight">Request a quote</h2>
        <p class="mt-2 mb-8 text-muted">All fields except phone are required.</p>
        <QuoteForm />
      </div>

      <div class="space-y-6 lg:col-span-5">
        <div class="card reveal overflow-clip">
          <a href={`tel:${SITE.emergencyPhone.tel}`} class="contact-row bg-deep text-white">
            <Icon name="bolt" class="contact-icon text-white" />
            <span>
              <span class="block text-sm text-white/75">24/7 emergency line</span>
              <span class="block text-xl font-extrabold tracking-tight">{SITE.emergencyPhone.display}</span>
            </span>
          </a>
          <a href={`tel:${SITE.phone.tel}`} class="contact-row">
            <Icon name="phone" class="contact-icon" />
            <span>
              <span class="block text-sm text-muted">Office</span>
              <span class="block text-lg font-bold">{SITE.phone.display}</span>
            </span>
          </a>
          <a href={`mailto:${SITE.email}`} class="contact-row">
            <Icon name="mail" class="contact-icon" />
            <span>
              <span class="block text-sm text-muted">Email</span>
              <span class="block text-lg font-bold">{SITE.email}</span>
            </span>
          </a>
          <div class="contact-row">
            <Icon name="map-pin" class="contact-icon" />
            <address class="not-italic">
              <span class="block text-sm text-muted">Workshop</span>
              <span class="block font-bold">{address.street}, {address.city}, {address.region} {address.postalCode}</span>
            </address>
          </div>
        </div>

        <div class="card reveal p-6 sm:p-7">
          <h2 class="flex items-center gap-2.5 text-lg font-bold"><Icon name="clock" class="text-accent-ink" /> Opening hours</h2>
          <dl class="mt-5 divide-y divide-line">
            {
              SITE.hours.map((h) => (
                <div class="flex justify-between gap-4 py-3">
                  <dt class="text-muted">{h.label}</dt>
                  <dd class="font-semibold">{h.opens && h.closes ? `${h.opens} – ${h.closes}` : "Closed"}</dd>
                </div>
              ))
            }
          </dl>
          {SITE.hoursNote && <p class="mt-4 text-sm text-muted">{SITE.hoursNote}</p>}
        </div>

        <div class="reveal">
          <MapPlaceholder />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-row {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.25rem 1.5rem;
    border-top: 1px solid var(--c-line);
    transition: background-color 0.2s;
  }
  .contact-row:first-child {
    border-top: 0;
  }
  a.contact-row:not(.bg-deep):hover {
    background: var(--c-surface-2);
  }
  a.contact-row.bg-deep:hover {
    background: color-mix(in oklab, var(--c-deep) 85%, white);
  }
  .contact-row :global(.contact-icon) {
    flex: none;
    color: var(--accent-ink);
  }
  .contact-row.bg-deep :global(.contact-icon) {
    color: #fff;
  }
</style>
