---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import { SITE } from "../config";

// Visitors land here after the plain HTML form (no JavaScript) was accepted by Formgong.
const steps = [
  "The office reads your request and checks which plumber is nearest.",
  "We call or email within an hour during opening hours, with a price range or a time to visit.",
  "On the visit, you agree the written price before any work starts.",
];
---

<BaseLayout title="Thank you" description="Your request has been received." noindex>
  <section class="relative overflow-x-clip">
    <div class="container-x py-20 sm:py-28">
      <div class="mx-auto max-w-2xl text-center">
        <span class="mx-auto grid size-20 place-items-center rounded-full bg-success/12 text-success">
          <Icon name="check" size={40} />
        </span>
        <h1 class="h-display mt-8 text-[clamp(2.25rem,1.6rem+2.8vw,3.5rem)]">We have your request</h1>
        <p class="lead mt-6">What happens next:</p>
      </div>
      <ol class="stagger mx-auto mt-12 grid max-w-2xl gap-4">
        {
          steps.map((step, i) => (
            <li class="card flex items-center gap-5 p-5 sm:p-6" style={`--i:${i}`}>
              <span class="grid size-10 shrink-0 place-items-center rounded-full bg-accent text-sm font-extrabold text-accent-text">{i + 1}</span>
              <span class="font-semibold">{step}</span>
            </li>
          ))
        }
      </ol>
      <div class="mx-auto mt-12 flex max-w-2xl flex-col justify-center gap-3 sm:flex-row">
        <a href="/" class="btn btn-secondary btn-lg">Back to the home page</a>
        <a href={`tel:${SITE.emergencyPhone.tel}`} class="btn btn-primary btn-lg">
          <Icon name="bolt" /> Emergency? {SITE.emergencyPhone.display}
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
