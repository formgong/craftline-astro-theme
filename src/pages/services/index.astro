---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeader from "../../components/PageHeader.astro";
import ServiceCard from "../../components/ServiceCard.astro";
import HowItWorks from "../../components/sections/HowItWorks.astro";
import QuoteSection from "../../components/sections/QuoteSection.astro";
import { SITE } from "../../config";

const services = (await getCollection("services")).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="Services"
  description={`Emergency plumbing, leak detection, drain cleaning, water heaters, boilers and fixtures in ${SITE.address.city}. Written price before work starts, two-year labor guarantee.`}
>
  <PageHeader
    title="Plumbing and heating services"
    lead="Six kinds of work cover almost every call we get. Each page lists what a visit includes and a typical starting price."
    crumbs={[{ label: "Services" }]}
  />
  <section class="section" aria-label="All services">
    <div class="container-x">
      <ul class="stagger grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {
          services.map((service, i) => (
            <li style={`--i:${i % 3}`}>
              <ServiceCard service={service} />
            </li>
          ))
        }
      </ul>
    </div>
  </section>
  <HowItWorks />
  <QuoteSection />
</BaseLayout>
