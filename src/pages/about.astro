---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import VanIllustration from "../components/illustrations/VanIllustration.astro";
import Stats from "../components/sections/Stats.astro";
import QuoteSection from "../components/sections/QuoteSection.astro";
import { SITE } from "../config";

const habits = [
  {
    title: "Covers on, then tools out",
    text: "Shoe covers and drop cloths go down before the toolbox opens. Old pipe, packaging and replaced parts leave with us.",
  },
  {
    title: "Photos of the fault and the fix",
    text: "We photograph what failed and the finished repair, and attach both to the invoice. Useful for insurers and the next owner of the house.",
  },
  {
    title: "The price doesn't move",
    text: "If a job takes longer than we planned, that's on us. The written price only changes if you approve extra work.",
  },
];
---

<BaseLayout
  title="About us"
  description={`${SITE.name}: licensed, insured plumbers and heating engineers working in ${SITE.address.city} for ${SITE.trust.years} years.`}
>
  <PageHeader
    title={`Plumbers in ${SITE.address.city} *since 2001*`}
    lead="Eleven licensed plumbers, eight vans and an office on Copperline Road. A dispatcher answers the phone day and night, and every van carries the parts for the twenty most common repairs."
    crumbs={[{ label: "About" }]}
  />

  <section class="section overflow-x-clip">
    <div class="container-x grid items-center gap-14 lg:grid-cols-2 lg:gap-16">
      <div class="reveal order-2 lg:order-1">
        <h2 class="h-section">Two apprentices and a <span class="hl">secondhand van</span></h2>
        <div class="prose-craft mt-6">
          <p>
            We started in 2001 with one van and a phone on a kitchen table. Most early jobs came from neighbors who heard
            we'd turned up on a Sunday night for a burst pipe and charged the same as a Tuesday.
          </p>
          <p>
            We still train our own apprentices and don't use subcontractors, so the plumber at your door has worked with us
            for years. The weekend rate is still the weekday rate, and that includes emergency call-outs at night.
          </p>
        </div>
      </div>
      <div class="reveal order-1 lg:order-2">
        <VanIllustration />
      </div>
    </div>
  </section>

  <section class="border-t border-line bg-surface py-20 sm:py-24" aria-labelledby="habits-title">
    <div class="container-x">
      <h2 id="habits-title" class="h-section reveal max-w-2xl text-[clamp(1.75rem,1.4rem+1.4vw,2.5rem)]">On <span class="hl">every</span> job</h2>
      <ol class="stagger mt-12 grid gap-10 md:grid-cols-3 md:gap-12">
        {
          habits.map((h, i) => (
            <li class="border-t border-line pt-6" style={`--i:${i}`}>
              <h3 class="text-xl font-bold tracking-tight">{h.title}</h3>
              <p class="mt-3 leading-relaxed text-muted">{h.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <Stats />

  <QuoteSection />
</BaseLayout>
